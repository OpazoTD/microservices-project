# =========================
# Microservices Project ENV
# =========================
# Copia este archivo a .env antes de levantar el stack:
# PowerShell: Copy-Item .env.example .env
# Bash:       cp .env.example .env

# Entorno
NODE_ENV=production
JWT_SECRET=tu_clave_super_secreta

# API Gateway
GATEWAY_PORT=3000

# PostgreSQL (usuarios)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=usuarios_db
POSTGRES_EXTERNAL_PORT=5433

# MySQL (productos)
MYSQL_ROOT_PASSWORD=root123
MYSQL_USER=admin
MYSQL_PASSWORD=admin123
MYSQL_DATABASE=productos_db
MYSQL_EXTERNAL_PORT=3307

# MongoDB (facturas)
MONGO_EXTERNAL_PORT=27018

# Microservicios
USUARIOS_EXTERNAL_PORT=3001
PRODUCTOS_HTTP_PORT=3002
PRODUCTOS_TCP_PORT=3004
FACTURAS_TCP_PORT=3003

# Bootstrap de administrador
AUTO_SEED_ADMIN=true
ADMIN_EMAIL=admin@correo.com
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Administrador
